    {
        "id": "3f3304e59bee28ef",
        "type": "function",
        "z": "c3720fe9e31dc918",
        "name": "Process rain's data",
        "func": "let totalRain = 0;\nlet firstRainTime = \"\";\nlet maxRain = 0;\n\n// 24h = 8 forecast blocks\nfor (let i = 0; i < 8 && i < msg.payload.length; i++) {\n\n    let item = msg.payload[i];\n\n    if (item.rain && item.rain[\"3h\"]) {\n\n        let rainAmount = item.rain[\"3h\"];\n\n        totalRain += rainAmount;\n\n        if (!firstRainTime) {\n            firstRainTime = new Date(item.dt_txt).toLocaleString();\n        }\n\n        if (rainAmount > maxRain) {\n            maxRain = rainAmount;\n        }\n    }\n}\n\ntotalRain = Math.round(totalRain * 100) / 100;\n\nmsg.payload = {\n    total24h: totalRain,\n    firstRain: firstRainTime,\n    max3h: maxRain\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
