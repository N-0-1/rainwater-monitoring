    },
    {
        "id": "0ebb5279a1f7df05",
        "type": "function",
        "z": "c3720fe9e31dc918",
        "name": "first-app-0",
        "func": "\nvar update = false;\nvar msg1 = {};\n\nif (msg.appID !== \"it-test\"){\n    return;\n}\n\nif(typeof msg.payload.decoded.batteryVoltage !== 'undefined') {\n\n    msg1.payload = msg.payload.decoded.batteryVoltage;\n    node.send([[null], [null], [null], [null], [msg1]]);\n    update = true;\n}\n\nif(typeof msg.payload.decoded.flowMeter !== 'undefined') {\n  \n    msg1.payload = msg.payload.decoded.flowMeter;\n    node.send([[null], [null], [null], [msg1],[null]]);\n    update = true;\n}\n\nif(typeof msg.payload.decoded.levelMeter !== 'undefined') {\n\n    msg1.payload = msg.payload.decoded.levelMeter;\n    node.send([[null],[null],[msg1],[null],[null]]);\n    update = true;\n}\n\nif(update){\n\n    msg1.payload = msg.devID;\n    node.send([[null], [msg1],[null],[null],[null]]);\n}\nif(update){\n    msg1.payload = msg.dateTime.substr(0, 16);  \n    node.send([[msg1], [null],[null],[null],[null]]);\n}\n\n    ",
